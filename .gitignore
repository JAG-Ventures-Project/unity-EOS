# Unity .gitignore for root or subfolder project setups
# Covers both root-level and nested Unity projects (e.g. unity-EOS/)

# Unity build & runtime temp/cache folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/

# Agent configuration & scratch files
.agents/

# Unity log files
*.log

# Blender backup files
*.blend1
*.blend1.meta

# JetBrains Rider
**/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
.idea/

# Visual Studio / VS Code
.vs/
.vscode/
omnisharp.json
Directory.Build.props
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports & Mono dumps
sysinfo.txt
mono_crash.*

# Builds and packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Gradle cache
.gradle/

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*
**/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
ServerData/
**/ServerData/
**/[Aa]ssets/StreamingAssets/aa*
**/[Aa]ssets/AddressableAssetsData/link.xml*
**/[Aa]ssets/Addressables_Temp*
**/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# UI Toolkit auto-generated files
UIElementsSchema/
**/UIElementsSchema/

# Auto-generated cache in Assets folder
**/[Aa]ssets/[Ss]ceneDependencyCache*

# OS generated files
[Tt]humbs.db
.DS_Store
